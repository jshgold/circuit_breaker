#!/bin/sh
# pre-push 훅: 푸시 전에 일반 테스트(./gradlew test)를 실행하고, 실패하면 푸시를 중단한다.
# - @Tag("simulation") 테스트는 test 태스크에서 제외되므로 여기서 돌지 않는다.
# - 우회: git push --no-verify
# 설명: docs/phase_etc_git-pre-push-hook.md

# 푸시할 ref 목록이 표준입력으로 들어온다: <local ref> <local sha> <remote ref> <remote sha>
# 브랜치 삭제 푸시는 local sha가 전부 0이다. 삭제만 하는 푸시는 검사할 코드가 없으므로 건너뛴다.
has_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) has_push=1 ;;
  esac
done
if [ "$has_push" = 0 ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel) || exit 1

# 시스템 기본 java는 17이고 프로젝트는 Java 21 툴체인을 쓴다. 21을 찾으면 지정한다 (macOS 전용).
if java_home=$(/usr/libexec/java_home -v 21 2>/dev/null); then
  export JAVA_HOME="$java_home"
fi

cd "$repo_root/circuitbreaker" || exit 1

echo "pre-push: ./gradlew test 실행 중..."
# 표준입력을 Gradle이 가져가지 않도록 /dev/null로 막는다.
if ./gradlew test --console=plain < /dev/null; then
  echo "pre-push: 테스트 통과. 푸시를 진행합니다."
else
  echo "pre-push: 테스트 실패. 푸시를 중단합니다. (우회: git push --no-verify)" >&2
  exit 1
fi
